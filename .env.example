# Teach Daso — example environment file.
#
# Every variable below is SERVER-ONLY. None of them may be prefixed with NEXT_PUBLIC_,
# because that prefix inlines a value into the client bundle (engineering plan E.10).
# Nothing in Phase 1 reads these; they are declared here so that the two permitted
# model roles (spec section 8) have a named, reviewable configuration surface before
# Phase 4 and Phase 7 create the two route files that may use them.
#
# Leave every value empty in version control. Real values belong in .env.local only.
#
# Phase 4's teaching route is the only file that may read TEACHING_AGENT_CREDENTIAL
# and MODEL_PROVIDER_BASE_ADDRESS. The evidence-agent credential remains unread until P7.

# Credential for the Teaching Agent role (spec section 7.3). Server-only.
TEACHING_AGENT_CREDENTIAL=

# Credential for the Evidence Agent role (spec section 7.8). Server-only.
EVIDENCE_AGENT_CREDENTIAL=

# Base address of the inference provider. Server-only. No default is supplied on
# purpose: an absent value must fail loudly rather than silently reach a default host.
MODEL_PROVIDER_BASE_ADDRESS=
